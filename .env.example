# FixTrack — Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# URL of the running FastAPI backend (no trailing slash)
# For local development:
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Set to "true" to run in offline demo mode (no backend required)
# All login/data will use mock data from src/data/
VITE_OFFLINE_DEMO=false
