# FixTrack Backend — Environment Variables
# Copy this file to .env and fill in your values

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=FixTrack
APP_VERSION=1.0.0
DEBUG=false

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev, zero config):
DATABASE_URL=sqlite+aiosqlite:///./fixtrack_dev.db

# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/fixtrack_db

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# CORS_ORIGINS=["http://localhost:5173","https://your-vercel-app.vercel.app"]
